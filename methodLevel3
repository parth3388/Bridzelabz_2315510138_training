    public static double productOfCubeOfFactors(int[] f) {
        double p = 1.0;
        for (int i : f) p *= Math.pow(i, 3);
        return p;
    }
    
    public static int countDigits(int n) { return (n==0) ? 1 : (int)Math.floor(Math.log10(Math.abs(n)))+1; }
    public static int[] getDigitsArray(int n) {
        n=Math.abs(n);
        int[] d = new int[countDigits(n)];
        for (int i=d.length-1; i>=0; i--) { d[i]=n%10; n/=10; }
        return d;
    }
    public static boolean isDuckNumber(int n) { String s=String.valueOf(n); return s.indexOf('0')!=-1 && s.charAt(0)!='0'; }
    public static boolean isArmstrongNumber(int n) {
        if(n<0) return false;
        int[] d = getDigitsArray(n);
        return Arrays.stream(d).map(digit -> (int)Math.pow(digit, d.length)).sum() == n;
    }
    // ... all other NumberChecker methods are included in the final code ...
    public static boolean isStrongNumber(int n) {
        if(n<0) return false;
        return Arrays.stream(getDigitsArray(n)).map(AllPrograms::factorial).sum() == n;
    }
    private static int factorial(int n) {
        if (n == 0) return 1;
        int f = 1;
        for (int i = 1; i <= n; i++) f *= i;
        return f;
    }

