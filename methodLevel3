    public static int[][] addMatrices(int[][] a, int[][] b) {
        if (a.length != b.length || a[0].length != b[0].length) return null;
        int[][] res = new int[a.length][a[0].length];
        for (int i = 0; i < a.length; i++) for (int j = 0; j < a[0].length; j++) res[i][j] = a[i][j] + b[i][j];
        return res;
    }

    public static int[][] subtractMatrices(int[][] a, int[][] b) {
        if (a.length != b.length || a[0].length != b[0].length) return null;
        int[][] res = new int[a.length][a[0].length];
        for (int i = 0; i < a.length; i++) for (int j = 0; j < a[0].length; j++) res[i][j] = a[i][j] - b[i][j];
        return res;
    }

    public static int[][] multiplyMatrices(int[][] a, int[][] b) {
        if (a[0].length != b.length) return null;
        int[][] res = new int[a.length][b[0].length];
        for (int i=0; i<res.length; i++) for(int j=0; j<res[0].length; j++) for(int k=0; k<a[0].length; k++) res[i][j] += a[i][k] * b[k][j];
        return res;
    }
    
    public static int[][] transpose(int[][] m) {
        int[][] res = new int[m[0].length][m.length];
        for (int i=0; i<m.length; i++) for(int j=0; j<m[0].length; j++) res[j][i] = m[i][j];
        return res;
    }

    public static int determinant2x2(int[][] m) {
        if (m.length != 2 || m[0].length != 2) return 0;
        return m[0][0] * m[1][1] - m[0][1] * m[1][0];
    }
    
    public static String getMonthName(int m) { return new String[]{"", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}[m]; }
    public static int getNumberOfDays(int m, int y) {
        int[] days = {0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        return (m == 2 && isLeapYear(y)) ? 29 : days[m];
    }

    public static int getFirstDayOfMonth(int m, int y) {
        int y0 = y - (14 - m) / 12;
        int x = y0 + y0 / 4 - y0 / 100 + y0 / 400;
        int m0 = m + 12 * ((14 - m) / 12) - 2;
        return (1 + x + (31 * m0) / 12) % 7;
    }

    public static void displayCalendar(int m, int y) {
        int startDay = getFirstDayOfMonth(m, y);
        int numDays = getNumberOfDays(m, y);
        System.out.println("   " + getMonthName(m) + " " + y);
        System.out.println("Su  Mo  Tu  We  Th  Fr  Sa");
        for (int i = 0; i < startDay; i++) System.out.print("    ");
        for (int i = 1; i <= numDays; i++) {
            System.out.printf("%3d ", i);
            if ((i + startDay) % 7 == 0) System.out.println();
        }
        System.out.println();
    }
    
