    public static double[][] calculateBonusAndNewSalary(double[][] d) {
        double[][] n = new double[d.length][2];
        for (int i=0; i<d.length; i++) {
            double bonus = d[i][0] * (d[i][1] > 5 ? 0.05 : 0.02);
            n[i][0] = d[i][0] + bonus;
            n[i][1] = bonus;
        }
        return n;
    }

