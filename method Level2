            System.out.println("7. Gallons <=> Liters");
            System.out.println("0. Return to Main Menu");
            System.out.print("Enter your choice: ");
            choice = scanner.nextInt();
            double value;
            switch(choice) {
                case 1:
                    System.out.print("Enter value: ");
                    value = scanner.nextDouble();
                    System.out.printf("%.2f km is %.2f miles.%n", value, convertKmToMiles(value));
                    System.out.printf("%.2f miles is %.2f km.%n", value, convertMilesToKm(value));
                    break;
                case 2:
                    System.out.print("Enter value: ");
                    value = scanner.nextDouble();
                    System.out.printf("%.2f meters is %.2f feet.%n", value, convertMetersToFeet(value));
                    System.out.printf("%.2f feet is %.2f meters.%n", value, convertFeetToMeters(value));
                    break;
                case 3:
                    System.out.print("Enter value: ");
                    value = scanner.nextDouble();
                    System.out.printf("%.2f yards is %.2f feet.%n", value, convertYardsToFeet(value));
                    System.out.printf("%.2f feet is %.2f yards.%n", value, convertFeetToYards(value));
                    break;
                case 4:
                    System.out.print("Enter value in inches: ");
                    value = scanner.nextDouble();
                    System.out.printf("%.2f inches is %.2f cm.%n", value, convertInchesToCm(value));
                    System.out.printf("%.2f inches is %.2f meters.%n", value, convertInchesToMeters(value));
                    break;
                case 5:
                    System.out.print("Enter temperature: ");
                    value = scanner.nextDouble();
                    System.out.printf("%.2f C is %.2f F.%n", value, convertCelsiusToFahrenheit(value));
                    System.out.printf("%.2f F is %.2f C.%n", value, convertFahrenheitToCelsius(value));
