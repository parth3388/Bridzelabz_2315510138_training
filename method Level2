                    System.out.printf("%.2f gallons is %.2f liters.%n", value, convertGallonsToLiters(value));
                    break;
                case 0:
                    System.out.println("Returning to main menu...");
                    break;
                default:
                    System.out.println("Invalid choice.");
                    break;
            }
        } while (choice != 0);
    }
    
