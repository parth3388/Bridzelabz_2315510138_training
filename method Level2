    public static void calculateBMI(double[][] data) {
        for (int i = 0; i < data.length; i++) {
            double weight = data[i][0];
            double heightInCm = data[i][1];
            double heightInM = heightInCm / 100.0;
            data[i][2] = weight / (heightInM * heightInM);
        }
    }

    public static String getBMIStatus(double bmi) {
        if (bmi < 18.5) return "Underweight";
        else if (bmi < 25) return "Normal weight";
        else if (bmi < 30) return "Overweight";
        else return "Obesity";
    }

    public static boolean isLeapYear(int year) {
        if (year < 1582) return false;
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }
    
    public static int[] findFactors(int number) {
        int count = 0;
        for (int i = 1; i <= number; i++) { if (number % i == 0) count++; }
        int[] factors = new int[count];
        int index = 0;
        for (int i = 1; i <= number; i++) { if (number % i == 0) factors[index++] = i; }
        return factors;
    }

    public static long sumFactors(int[] factors) {
        long sum = 0;
        for (int factor : factors) { sum += factor; }
        return sum;
    }

    public static long productFactors(int[] factors) {
        long product = 1;
        for (int factor : factors) { product *= factor; }
        return product;
    }

    public static double sumOfSquaresOfFactors(int[] factors) {
        double sumOfSquares = 0;
        for (int factor : factors) { sumOfSquares += Math.pow(factor, 2); }
        return sumOfSquares;
    }
    
